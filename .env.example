# ---- GitHub ----
# 强烈建议配置：未认证仅 60 次/小时，配 Token 后 5000 次/小时
# 生成地址 https://github.com/settings/tokens （只读公开仓库无需任何 scope）
GITHUB_TOKEN=

# ---- 大模型（可选，不配则运行规则模式）----
# 任何 OpenAI 兼容接口均可：DeepSeek / 通义 / 智谱 / 本地 Ollama
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# ---- 向量检索（可选，不配则只用 BM25）----
# 配了 EMBED_MODEL 才会启用「BM25 + 向量」混合检索；不配就走纯 BM25。
# 注意：DeepSeek 只有对话接口、没有 embeddings，需要另找一家（或本地服务）。
# EMBED_BASE_URL 和 EMBED_API_KEY 不填时，会复用上面的 LLM_BASE_URL / LLM_API_KEY。
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_MODEL=text-embedding-3-small
# EMBED_API_KEY=

# ---- 网络代理（可选）----
# 访问 GitHub 需要代理时填本地代理地址。留空则直连。
# 常见端口：Clash 7897 / v2rayN 10809 / 其它以客户端为准
# HTTPS_PROXY=http://127.0.0.1:7897

# ---- 其他 ----
# DEVPRISM_CACHE=.cache/devprism.sqlite3
# DEVPRISM_TIMEOUT=20
